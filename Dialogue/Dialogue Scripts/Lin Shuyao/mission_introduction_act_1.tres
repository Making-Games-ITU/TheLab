[sub_resource type="Resource" id="Resource_mdscu"]
script = ExtResource("2_p6gug")
phrases = Array[Dictionary]([{
"end": 1.8,
"start": 0.0,
"text": "I assume you read the note, "
}, {
"end": 2.5,
"start": 2.2,
"text": "good. "
}, {
"end": 5.5,
"start": 3.0,
"text": "If you need more information about how the whole testing procedure works, "
}, {
"end": 7.5,
"start": 5.8,
"text": "there should be a pinboard in the lab."
}])
sentence_id = "c18da72b-b90b-491d-8be9-84f066fa8570"
