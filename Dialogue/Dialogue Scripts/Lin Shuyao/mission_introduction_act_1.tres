[sub_resource type="Resource" id="Resource_rkplp"]
script = ExtResource("2_p6gug")
phrases = Array[Dictionary]([{
"end": 2.0,
"start": 0.0,
"text": "I was sent here by GRAKOWICZ to bring you this. "
}, {
"end": 4.0,
"start": 2.5,
"text": "It seems to be very important. "
}, {
"end": 6.0,
"start": 4.5,
"text": "Common now, take a look at it."
}])
sentence_id = "e43c0813-d836-499a-9d7f-1879744e3400"
