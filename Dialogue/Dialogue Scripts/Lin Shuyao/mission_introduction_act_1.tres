[sub_resource type="Resource" id="Resource_pbrfv"]
script = ExtResource("2_p6gug")
phrases = Array[Dictionary]([{
"end": 1.5,
"start": 0.0,
"text": "The door seems to be on lockdown; "
}, {
"end": 4.5,
"start": 2.0,
"text": "I heard that something is happening at the dining sector. "
}])
sentence_id = "6263c058-62b2-4def-921e-978a332b5144"
