[sub_resource type="Resource" id="Resource_3rwca"]
script = ExtResource("2_p6gug")
phrases = Array[Dictionary]([{
"end": 1.0,
"start": 0.0,
"text": "Good! "
}, {
"end": 2.2,
"start": 1.5,
"text": "The power is back on. "
}, {
"end": 3.5,
"start": 2.4,
"text": "I will go and find out what is happening in the dining sector. "
}, {
"end": 3.5,
"start": 2.6,
"text": "Maybe I will be able to turn off the lockdown. "
}, {
"end": 4.0,
"start": 3.6,
"text": "I will be back soon."
}])
sentence_id = "7eb6ec85-442b-4d72-8dd7-9f2558b68c04"
