"end": 1.8,
"start": 0.0,
"text": "I assume you read the note, "
}, {
"end": 2.5,
"start": 2.2,
"text": "good. "
}, {
"end": 5.5,
"start": 3.0,
"text": "If you need more information about how the whole testing procedure works, "
}, {
"end": 7.5,
"start": 5.8,
"text": "there should be a pinboard in the lab."
}])
sentence_id = "c18da72b-b90b-491d-8be9-84f066fa8570"
next_sentence_id = "7eb6ec85-442b-4d72-8dd7-9f2558b68c04"
metadata/_custom_type_script = "uid://bbug2xt6gy8sv"

[sub_resource type="Resource" id="Resource_mdscu"]
script = ExtResource("114_xb2jk")
phrases = Array[Dictionary]([{
"end": 1.0,
"start": 0.0,
"text": "Oh... "
}, {
"end": 2.2,
"start": 1.5,
"text": "one last thing. "
}, {
"end": 6.0,
"start": 2.4,
"text": "I dropped the flash drive into the vent, and it should be dropped near one of the vents. "
}, {
"end": 9.0,
"start": 6.0,
"text": "Use that flash drive to turn the power back on. "
}, {
"end": 11.0,
"start": 9.0,
"text": "The electrical box is hard to miss. "
}])
sentence_id = "7eb6ec85-442b-4d72-8dd7-9f2558b68c04"
metadata/_custom_type_script = "uid://bbug2xt6gy8sv"

[sub_resource type="Resource" id="Resource_3rwca"]
script = ExtResource("114_xb2jk")
phrases = Array[Dictionary]([{
"end": 1.0,
"start": 0.0,
"text": "Good! "
}, {
"end": 2.2,
"start": 1.5,
"text": "The power is back on. "
}, {
"end": 4.5,
"start": 2.4,
"text": "I will go and find out what is happening in the dining sector. "
}, {
"end": 6.0,
"start": 4.5,
"text": "Maybe I will be able to turn off the lockdown. "
}, {
"end": 7.0,
"start": 6.0,
"text": "I will be back soon."
}])
sentence_id = "940724dd-fe4c-4689-a09e-d38e5a250648"
metadata/_custom_type_script = "uid://bbug2xt6gy8sv"

