[sub_resource type="Resource" id="Resource_4surw"]
script = ExtResource("114_xb2jk")
phrases = Array[Dictionary]([{
"end": 1.8,
"start": 0.0,
"text": "Hey! I can hear you in there. "
}, {
"end": 3.8,
"start": 2.5,
"text": "You should be Sergey Markov  "
}, {
"end": 5.5,
"start": 4.38,
"text": "the one replacing... "
}, {
"end": 6.5,
"start": 5.8,
"text": "Kravchenko"
}])
sentence_id = "f3f09eb8-35a1-46e5-b468-a4878494cfe9"
next_sentence_id = "6263c058-62b2-4def-921e-978a332b5144"
metadata/_custom_type_script = "uid://bbug2xt6gy8sv"

[sub_resource type="Resource" id="Resource_yvjjv"]
script = ExtResource("114_xb2jk")
phrases = Array[Dictionary]([{
"end": 1.5,
"start": 0.0,
"text": "The door seems to be on lockdown; "
}, {
"end": 4.5,
"start": 2.0,
"text": "I heard that something is happening at the dining sector. "
}])
sentence_id = "6263c058-62b2-4def-921e-978a332b5144"
next_sentence_id = "e43c0813-d836-499a-9d7f-1879744e3400"
