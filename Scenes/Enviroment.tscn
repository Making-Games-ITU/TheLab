[node name="RichTextLabel" type="RichTextLabel" parent="Note Reader/Panel/MarginContainer" unique_id=337117333]
layout_mode = 2
theme_override_fonts/normal_font = ExtResource("37_jjvax")
text = "I am writing this guide once again, because SOMEBODY keeps magically losing the paper. The procedure itself is not that hard, just take an empty test tube, go to the blood collector machine and press some buttons, you will figure. After you get the warm blood, you will have to centrifuge it before using the microscope. That is pretty much it, I do not remember how the pipetting tool works, you can probably find the documentation somewhere else. PLEASE do not lose this paper, I am sick of rewriting this guide.

Konstantin Markov"
scroll_active = false

