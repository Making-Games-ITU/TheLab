[node name="Label" parent="Note_document2/Note Viewport/Control/TextureRect" parent_id_path=PackedInt32Array(1030636860, 1592876479) index="0" unique_id=1296143046]
text = "Do not waste the substances they are very expensive. If you want to mix them, please use the Planetary Centrifugal Mixer. I have ordered more substances, they should arrive in aproximatly 2 days. If they do not arrive within these days, please contact the depot: 30 42 91 84

Mia Janova"

